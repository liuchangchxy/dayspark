<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/quick_add_todo"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="@string/widget_add_todo"
        android:textColor="@color/widget_accent"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/quick_add_event"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="@string/widget_add_event"
        android:textColor="@color/widget_accent"
        android:textSize="14sp" />
</LinearLayout>
