<?xml version="1.0" encoding="utf-8"?>
<!-- Copy comes from the snapshot ui block at runtime; rows are plain
     (checkboxes and quick-add live on the primary widget only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/upcoming_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/upcoming_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#1976D2"
            android:visibility="gone" />
        <TextView
            android:id="@+id/upcoming_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#999999" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/upcoming_text_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_secondary_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:textColor="#999999" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/upcoming_text_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_secondary_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:textColor="#999999" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/upcoming_text_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_secondary_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:textColor="#999999" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/upcoming_text_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_secondary_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:textColor="#999999" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/upcoming_text_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_secondary_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:textColor="#999999" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/upcoming_text_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_secondary_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:textColor="#999999" />
    </LinearLayout>

    <TextView
        android:id="@+id/upcoming_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#999999"
        android:visibility="gone" />

</LinearLayout>
