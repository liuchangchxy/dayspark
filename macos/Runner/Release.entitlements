<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.dayspark.app</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- WHY: keychain-access-groups key must stay ABSENT under adhoc/teamless signing — $(AppIdentifierPrefix) expands to bare bundle id and even an empty array makes taskgate reject spawn with SIGKILL "Taskgated Invalid Signature" (2026-09-24 crash; empty-array build re-proven). flutter_secure_storage uses the default keychain partition; only add this key with a real Developer-ID/team build. -->
</dict>
</plist>
